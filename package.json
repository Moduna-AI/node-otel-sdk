{
    "name": "@moduna/otel",
    "version": "0.2.0",
    "private": false,
    "description": "One-line OpenTelemetry setup for Moduna AI traces.",
    "license": "MIT",
    "type": "module",
    "main": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/src/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc",
        "format": "biome format",
        "lint": "biome lint",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "test": "pnpm run build && pnpm run typecheck",
        "prepack": "pnpm run build",
        "pack:dry-run": "pnpm pack --dry-run",
        "test:vercel-ai-sdk": "tsx test/vercel-ai-sdk.ts",
        "test:langchain": "tsx test/langchain.ts"
    },
    "dependencies": {
        "@langchain/core": "^1.1.46",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
        "@opentelemetry/resources": "^2.7.1",
        "@opentelemetry/sdk-node": "^0.218.0",
        "@opentelemetry/semantic-conventions": "^1.41.1",
        "langchain": "^1.4.0",
        "openai": "^6.38.0"
    },
    "devDependencies": {
        "@ai-sdk/google": "^3.0.73",
        "@langchain/google-genai": "^2.1.30",
        "@types/node": "^25.6.2",
        "ai": "^6.0.182",
        "biome": "^0.3.3",
        "tsx": "^4.12.0",
        "typescript": "^6.0.3"
    }
}
