{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"declaration": true,
		"types": ["node"],
		"rootDir": ".",
		"outDir": "dist",
		"declarationMap": true,
		"sourceMap": true
	},
	"include": ["src", "services", "interface", "types"]
}
