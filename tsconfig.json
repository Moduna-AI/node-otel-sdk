{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "declaration": true,
        "allowImportingTsExtensions": true,
        "emitDeclarationOnly": true,
        "types": [
            "node"
        ],
        "rootDir": ".",
        "outDir": "dist",
        "paths": {
			"@/*": ["./*"]
		}
    },
    "include": [
        "src",
        "services",
        "interface",
        "types"
    ]
}
